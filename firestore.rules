rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{userId} {
      function owner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      function validFeedback() {
        let d = request.resource.data;
        return d.keys().hasAll(['uid', 'rating', 'prepared', 'comment', 'courseVersion', 'completedModules', 'updatedAt'])
          && d.keys().hasOnly(['uid', 'rating', 'prepared', 'comment', 'courseVersion', 'completedModules', 'updatedAt'])
          && d.uid == request.auth.uid
          && d.rating is int && d.rating >= 1 && d.rating <= 5
          && d.prepared in ['oui', 'partiellement', 'non']
          && d.comment is string && d.comment.size() <= 1500
          && d.courseVersion == 'socle-v1'
          && d.completedModules == 8
          && d.updatedAt == request.time;
      }
      allow read: if false;
      allow create, update: if owner() && validFeedback();
      allow delete: if owner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
